# Normalize to LF in the repository, check out native on Windows.
# Without this, a Windows dev commits CRLF, the Linux/macOS CI runner sees a
# whole-file diff, and shell scripts fail with `bad interpreter: \r`.
* text=auto eol=lf

# Files that must stay LF even on Windows checkout
*.sh            text eol=lf
.githooks/*     text eol=lf

# Files that must stay CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Explicit binary — never diff, never normalize
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.avif          binary
*.gif           binary
*.ico           binary
*.icns          binary
*.onnx          binary
*.safetensors   binary
*.msi           binary
*.msix          binary
*.exe           binary
*.dll           binary

# Lockfiles: collapse in diffs, but still tracked
Cargo.lock      linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
pnpm-lock.yaml  linguist-generated=true -diff
